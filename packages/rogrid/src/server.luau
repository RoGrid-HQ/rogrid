--!strict
local pipeline = require("./pipeline")
local protocol = require("./protocol")

local server = {}

local started = false

-- The registry is generated by `rogrid generate` and mapped into the game by the Rojo project.
local function loadRegistry(): pipeline.Registry
	local generated = game:GetService("ServerScriptService"):FindFirstChild("RoGrid")
	local module = generated and generated:FindFirstChild("functions")
	if not module or not module:IsA("ModuleScript") then
		error("RoGrid: generated code not found at ServerScriptService.RoGrid. Run 'rogrid generate'.", 3)
	end

	local registry = (require :: any)(module)
	if registry.runtime ~= protocol.runtime then
		error(
			`RoGrid: generated code targets runtime {registry.runtime} but this library is runtime {protocol.runtime}. `
				.. "Update the rogrid CLI or the rogrid package so they match, then run 'rogrid generate'.",
			3
		)
	end
	return registry.functions
end

-- Opens the boundary. Call it once, when the server is ready to answer clients.
function server.start()
	local RunService = game:GetService("RunService")
	if not RunService:IsServer() then
		error("RoGrid.start can only be called on the server", 2)
	end
	if started then
		error("RoGrid.start was called twice", 2)
	end
	started = true

	local registry = loadRegistry()
	-- Bad input is worth seeing while developing. In a live game it is mostly exploiters, so it stays quiet.
	local logViolations = RunService:IsStudio()

	local remote = Instance.new("RemoteFunction")
	remote.Name = protocol.requestRemote
	remote.OnServerInvoke = function(player: Player, ...: any): (boolean, any)
		local name, input = ...
		local ok, result, detail = pipeline.run(registry, player, name, input)
		if not ok and detail and (result == "internal" or logViolations) then
			warn(`RoGrid: {player.Name}: {detail}`)
		end
		return ok, result
	end
	remote.Parent = game:GetService("ReplicatedStorage")
end

return server
